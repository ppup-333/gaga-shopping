# 伺服器連接埠
PORT=10000
NODE_ENV=development

# PostgreSQL 資料庫連線字串 (可使用 Render Free PostgreSQL 或 Neon / Supabase 免費資料庫)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gaga_shopping?schema=public"

# JWT 安全金鑰
JWT_SECRET="your_custom_super_secure_jwt_secret_key"

# Cloudinary 免費圖床設定 (至 https://cloudinary.com 免費註冊取得，解決 Render 重啟圖片遺失問題)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
