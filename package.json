{
  "name": "gaga-shopping",
  "version": "1.0.0",
  "description": "Multi-warehouse inventory and order registration system optimized for Render",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm run --prefix client dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run --prefix client build",
    "build": "npm install --include=dev && npm install --prefix client --include=dev && npm run build:client && npx prisma@6 generate",
    "prisma:generate": "npx prisma@6 generate",
    "prisma:push": "npx prisma@6 db push",
    "prisma:seed": "node server/src/seed.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "render",
    "inventory",
    "postgresql",
    "express",
    "react"
  ],
  "author": "",
  "license": "MIT"
}
